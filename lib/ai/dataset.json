  "umrah_steps": {
    "title_ar": "خطوات أداء العمرة",
    "title_en": "How to Perform Umrah",
    "source_note": "Standard, widely agreed-upon sequence as commonly taught; verify school-of-thought (madhhab) details with a qualified teacher before publishing as a fatwa-level guide.",
    "items": [
      { "step": 1, "ar": "الإحرام من الميقات: الاغتسال، لبس ملابس الإحرام، والنية، ثم التلبية.", "en": "Ihram at the Miqat: ritual bath, wearing ihram garments, making the intention, then reciting the Talbiyah." },
      { "step": 2, "ar": "الطواف حول الكعبة سبعة أشواط، يبدأ وينتهي عند الحجر الأسود.", "en": "Tawaf: seven circuits around the Ka'bah, starting and ending at the Black Stone." },
      { "step": 3, "ar": "صلاة ركعتين خلف مقام إبراهيم عليه السلام بعد الطواف.", "en": "Praying two rak'ahs behind the Station of Ibrahim after Tawaf." },
      { "step": 4, "ar": "السعي بين الصفا والمروة سبعة أشواط.", "en": "Sa'i: walking between Safa and Marwah seven times." },
      { "step": 5, "ar": "الحلق أو التقصير، وبه يتم التحلل من الإحرام وتنتهي العمرة.", "en": "Shaving or trimming the hair, which completes the Umrah." }
    ]
  },

  "morning_evening_adhkar": {
    "title_ar": "أذكار الصباح والمساء",
    "title_en": "Morning & Evening Remembrance",
    "source_note": "Representative, very widely cited examples; please cross-check exact wording/reference against Hisnul Muslim before publishing.",
    "items": [
      { "ar": "آيَةُ الْكُرْسِيّ (الآية 255 من سورة البقرة)", "en": "Ayat al-Kursi (Qur'an 2:255)", "note": "Widely recommended for morning and evening protection." },
      { "ar": "سورة الإخلاص، الفلق، والناس (ثلاث مرات صباحاً ومساءً)", "en": "Surah Al-Ikhlas, Al-Falaq, and An-Nas (recited three times morning and evening)" },
      { "ar": "أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ", "en": "'We have reached the morning and with it all dominion belongs to Allah...' — said in the morning." },
      { "ar": "أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ", "en": "'We have reached the evening and with it all dominion belongs to Allah...' — said in the evening." },
      { "ar": "اللَّهُمَّ بِكَ أَصْبَحْنَا وَبِكَ أَمْسَيْنَا، وَبِكَ نَحْيَا وَبِكَ نَمُوتُ وَإِلَيْكَ النُّشُورُ", "en": "'O Allah, by You we enter the morning/evening, by You we live and die, and to You is the resurrection.'" }
    ]
  },

  "after_prayer_duas": {
    "title_ar": "أذكار ما بعد الصلاة",
    "title_en": "Duas After the Prayer",
    "source_note": "Representative, very widely cited examples; please cross-check exact wording/reference against Hisnul Muslim before publishing.",
    "items": [
      { "ar": "أَسْتَغْفِرُ اللَّهَ (ثلاث مرات) ثم: اللَّهُمَّ أَنْتَ السَّلَامُ وَمِنْكَ السَّلَامُ تَبَارَكْتَ يَا ذَا الْجَلَالِ وَالْإِكْرَامِ", "en": "'I seek Allah's forgiveness' (three times), then: 'O Allah, You are Peace and from You is peace...'" },
      { "ar": "التسبيح والتحميد والتكبير (33 مرة لكل منها)، وتمام المئة بـ: لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ", "en": "Glorification (SubhanAllah), praise (Alhamdulillah) and magnification (Allahu Akbar), 33 times each, completed to 100 with the declaration of Tawheed." },
      { "ar": "آيَةُ الْكُرْسِيّ بعد كل صلاة مكتوبة", "en": "Ayat al-Kursi after every obligatory prayer." }
